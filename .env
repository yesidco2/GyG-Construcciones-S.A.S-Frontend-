# EmailJS para el formulario de contacto
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here

# Para el newsletter (opcional): endpoint público de Mailchimp, Brevo o Formspree
# Ejemplo: https://your-form-endpoint.example.com/subscribe
VITE_NEWSLETTER_ENDPOINT=

# Para la consulta de proyectos por código (opcional si se usa API real)
# VITE_PROJECTS_API_URL=https://api.example.com/projects

# API URL para desarrollo local
VITE_API_URL=http://localhost:8080
